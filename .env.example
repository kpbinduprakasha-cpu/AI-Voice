# Primary provider hint used when a specific provider is left blank.
# Values: openai | ollama | faster-whisper | pyttsx3 | edge-tts
# For 100% free local offline mode (no API key needed):
#   AI_PROVIDER=ollama
#   TRANSCRIPTION_PROVIDER=faster-whisper
#   LLM_PROVIDER=ollama
#   TTS_PROVIDER=pyttsx3
AI_PROVIDER=openai

# OpenAI-compatible API (OpenAI, Groq, together.ai, local vLLM, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Independent providers. Leave blank to inherit AI_PROVIDER.
# transcription: openai | faster-whisper
# llm: openai | ollama
# tts: openai | pyttsx3 | edge-tts
TRANSCRIPTION_PROVIDER=
LLM_PROVIDER=
TTS_PROVIDER=

TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=en
LLM_MODEL=gpt-4o-mini
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Local faster-whisper model size: tiny, base, small, medium, large-v3
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=cpu

# Limits and reliability
MAX_AUDIO_SIZE_MB=20
MAX_AUDIO_DURATION_SECONDS=120
REQUEST_TIMEOUT_SECONDS=90
GENERATED_AUDIO_RETENTION_MINUTES=60

# Comma-separated origins. Leave empty to serve same-origin only (recommended).
CORS_ORIGINS=
